{
  "name": "scrape_and_summarize",
  "description": "Scrape a website and return its AI-generated summary.",
  "params": ["url"],
  "optional_params": {
    "max_pages": 10,
    "max_depth": 2
  },
  "param_aliases": {
    "pages": "max_pages",
    "depth": "max_depth"
  },
  "param_constraints": {
    "max_pages": { "min": 1, "max": 200 },
    "max_depth": { "min": 1, "max": 8 }
  },
  "steps": [
    {
      "step_id": 1,
      "skill": "webscraper_skill",
      "method": "POST",
      "route": "/skills/webscraper_skill/scrape",
      "args": {
        "url": "{{url}}",
        "max_pages": "{{max_pages}}",
        "max_depth": "{{max_depth}}",
        "summarize": true
      },
      "poll": {
        "route": "/skills/webscraper_skill/scrape/$step.1.job_id",
        "field": "status",
        "target": "completed",
        "interval": 2,
        "max_attempts": 60
      }
    },
    {
      "step_id": 2,
      "skill": "webscraper_skill",
      "method": "GET",
      "route": "/skills/webscraper_skill/scrape/$step.1.job_id/summary",
      "depends_on": [1]
    }
  ],
  "created_at": "2026-03-10T00:00:00Z"
}
