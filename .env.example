# Storage server: encryption key for stored JSON.
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION_KEY=

# Transport encryption key for messages sent to/from servers.
# Generate a Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRANSPORT_ENCRYPTION_KEY=

# Registry server base URL (for clients/processes to discover servers)
REGISTRY_SERVER_URL=http://localhost:7002

# Configuration server -> Storage server base URL
STORAGE_SERVER_URL=http://localhost:7010

# AI server: default provider when a profile has no specific provider
AISERVER_DEFAULT_PROVIDER=ollama

# Per-profile provider (each profile can use a different provider)
# AISERVER_PROFILE_FAST_PROVIDER=google
# AISERVER_PROFILE_CHAT_PROVIDER=ollama
# AISERVER_PROFILE_REASON_PROVIDER=openai
# (same for AGENT, CODE, IMAGE, VIDEO)

# Per-profile model override (optional; else uses AISERVER_MODEL_{PROVIDER}_{PROFILE} or code default)
# AISERVER_PROFILE_FAST_MODEL=gemini-3-flash-preview

# Provider API keys (required for remote providers)
OPENAI_API_KEY=
XAI_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=

# W&B Inference (aiserver provider + wandb_ai_provider.py); get key from https://wandb.ai/authorize
WANDB_API_KEY=
# Optional: team/project for Weave (standalone wandb_ai_provider.py only)
# WANDB_PROJECT=myteam/myproject

# Optional provider base URLs
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=https://api.openai.com
XAI_BASE_URL=https://api.x.ai
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com
PERPLEXITY_BASE_URL=https://api.perplexity.ai
# WANDB_INFERENCE_BASE_URL=https://api.inference.wandb.ai/v1

# Optional model overrides per provider/profile
# AISERVER_MODEL_OLLAMA_FAST=gemma3:4b
# AISERVER_MODEL_OLLAMA_CHAT=gemma3:4b
# AISERVER_MODEL_OLLAMA_REASON=gemma3:4b
# AISERVER_MODEL_OLLAMA_AGENT=gemma3:4b
# AISERVER_MODEL_OLLAMA_CODE=gemma3:4b
# AISERVER_MODEL_OLLAMA_IMAGE=gemma3:4b
# AISERVER_MODEL_OLLAMA_VIDEO=gemma3:4b
