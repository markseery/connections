# Ignore dotfiles except explicitly tracked ones
.*
!.env.example
!.gitignore
!.hooks/

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime data — lives in user dir (application_files/)
logs/
data/
application/
application_files/

.DS_Store

# User-specific files that belong in ~/.connections/scripts/ or ~/.connections/notes/
*.user.yaml
*.user.py
