# Ignore dotfiles except explicitly tracked ones
.*
!.env.example
!.gitignore
!.hooks/

__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Runtime data — logs + local app dir still ignored; data/ is versioned on request
logs/
application/

# Fernet-encrypted storage blobs: GitHub push protection often flags ciphertext as secrets
data/storage/**/*.enc

.DS_Store

# User-specific files that belong in ~/.connections/scripts/ or ~/.connections/notes/
*.user.yaml
*.user.py
